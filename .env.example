# Base URL of the backend API
VITE_API_URL=http://localhost:3000/api/v1

# Public address of the site, used for social share links and images (no trailing slash)
VITE_SITE_URL=http://localhost:5173

# Answer API calls with sample data from src/mocks until the backend is ready (true/false)
VITE_USE_MOCK_API=true
