# Settings used by `npm run build` (and therefore by Vercel). Nothing secret goes here.

# Public address of the site, used for social share links and images (no trailing slash).
# Change it if Vercel gives the project a different domain, or when the university domain is ready.
VITE_SITE_URL=https://university-mila-alpha.vercel.app

# The backend isn't online yet, so the site answers with the sample data from src/mocks.
# When the API is deployed: set VITE_USE_MOCK_API=false and VITE_API_URL=https://<api-host>/api/v1
VITE_USE_MOCK_API=true
VITE_API_URL=
